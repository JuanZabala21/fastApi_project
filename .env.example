# Copy this file to .env and fill in real values. .env is ignored by git; this template is committed,
# so NEVER put real secrets in it.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
MCP_TOKEN_EXPIRE_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- AI assistant (chat box). Leave ANTHROPIC_API_KEY empty to disable it. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ASSISTANT_EFFORT=medium
ASSISTANT_MESSAGES_PER_HOUR=30
ASSISTANT_ALLOW_DELETE=false

# "mcp" = the chat talks to our MCP server (FastAPI is the MCP client). "direct" = tools run in-process.
ASSISTANT_MODE=mcp
# Where the MCP server reaches this API (must match the host/port uvicorn runs on)
ASSISTANT_API_URL=http://127.0.0.1:8000
